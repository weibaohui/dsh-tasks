{
  "name": "@weibaohui/dsh-tasks",
  "version": "0.5.9",
  "description": "dsh 插件 · 定时任务：用 cron 表达式定时执行提示词，到点自动开一个新 agent 会话替你干活，也可随时手动立即执行；可视化选择器实时预览最近 5 次执行时间，支持绑定工作区、指定模型、会话按任务自动命名、cron 即时校验与全屏管理页，执行记录可一键打开对应会话；任务开始/完成/失败可推送到 IM 投递插件绑定的聊天渠道，执行结论可随通知一并推送；支持免打扰时段（跨零点友好），时段内推送自动跳过。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "cron",
    "schedule",
    "scheduled-items",
    "dsh-plugin"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.5",
    "dsh": ">=0.1.7-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check client/cron.js && node --check client/index.js",
    "test": "node --test test/*.test.mjs",
    "build:client": "node scripts/build-client.mjs",
    "prepublishOnly": "npm run build:client && npm run check && npm test"
  },
  "dependencies": {
    "croner": "^9.1.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weibaohui/dsh-tasks.git"
  },
  "homepage": "https://github.com/weibaohui/dsh-tasks#readme",
  "bugs": {
    "url": "https://github.com/weibaohui/dsh-tasks/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
